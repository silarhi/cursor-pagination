{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["config:recommended"],
    "platformAutomerge": true,
    "automergeType": "pr",
    "minimumReleaseAge": "3 days",
    "packageRules": [
        {
            "matchUpdateTypes": ["minor", "patch", "digest"],
            "automerge": true
        },
        {
            "matchUpdateTypes": ["major"],
            "automerge": false
        },
        {
            "matchManagers": ["composer"],
            "matchDepTypes": ["require-dev"],
            "rangeStrategy": "bump"
        },
        {
            "description": "doctrine/orm is tested against its minimal version: never raise the lower bound, only widen for new majors",
            "matchManagers": ["composer"],
            "matchPackageNames": ["doctrine/orm"],
            "rangeStrategy": "widen"
        }
    ]
}
