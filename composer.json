{
    "name": "silarhi/cursor-pagination",
    "description": "Cursor-based (keyset) pagination for Doctrine ORM, for fast batch processing of large tables",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "doctrine",
        "orm",
        "pagination",
        "cursor",
        "cursor-pagination",
        "keyset",
        "doctrine-orm",
        "keyset-pagination",
        "batch-processing"
    ],
    "authors": [
        {
            "name": "SILARHI",
            "email": "dev@silarhi.fr"
        }
    ],
    "homepage": "https://cursor-pagination.silarhi.dev",
    "support": {
        "issues": "https://github.com/silarhi/cursor-pagination/issues",
        "source": "https://github.com/silarhi/cursor-pagination",
        "docs": "https://cursor-pagination.silarhi.dev"
    },
    "require": {
        "php": ">=8.2",
        "doctrine/dbal": "^3.8.2 || ^4.0",
        "doctrine/orm": "^3.0"
    },
    "require-dev": {
        "doctrine/collections": "^2.2 || ^3.0",
        "doctrine/data-fixtures": "^2.2.2",
        "doctrine/persistence": "^3.3.1 || ^4.0",
        "ergebnis/composer-normalize": "^2.59.0",
        "friendsofphp/php-cs-fixer": "^3.95.32",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^2.3.7",
        "phpstan/phpstan-strict-rules": "^2.1.2",
        "phpunit/phpunit": "^11.5.58 || ^12.5.38 || ^13.4.1",
        "psr/log": "^1.0 || ^2.0 || ^3.0",
        "rector/rector": "^2.9.2",
        "symfony/cache": "^7.4.23 || ^8.0",
        "vimeo/psalm": "^5.26.1 || ^6.21.2 || ^7.0.0"
    },
    "autoload": {
        "psr-4": {
            "Silarhi\\CursorPagination\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Silarhi\\CursorPagination\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "phpstan/extension-installer": true
        },
        "audit": {
            "block-insecure": false
        },
        "bump-after-update": "dev",
        "sort-packages": true
    }
}
